  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "27.4.0",
    "vitest": "4.1.10"
  }
}
