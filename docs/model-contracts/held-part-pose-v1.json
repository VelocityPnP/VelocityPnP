{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velocitypnp.org/model-contracts/held-part-pose-v1.json",
  "title": "VelocityPnP held-part pose model v1",
  "description": "One condition and undirected pose prediction from paired bare-nozzle and observed images.",
  "type": "object",
  "required": ["state_log_probabilities", "pose"],
  "properties": {
    "state_log_probabilities": {
      "description": "Log probabilities in bare_nozzle, component_flat, component_on_edge order.",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "pose": {
      "description": "Normalized center and size followed by the doubled-angle unit vector.",
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": -1, "maximum": 1},
        {"type": "number", "minimum": -1, "maximum": 1}
      ],
      "minItems": 6,
      "maxItems": 6
    }
  },
  "additionalProperties": false,
  "x-velocitypnp": {
    "contract_version": "velocitypnp.held-part-pose.v1",
    "input": {
      "name": "image_pair",
      "layout": "NCHW",
      "shape": ["batch", 6, 192, 192],
      "channels": [
        "bare_red",
        "bare_green",
        "bare_blue",
        "observed_red",
        "observed_green",
        "observed_blue"
      ],
      "type": "float32",
      "range": [0, 1],
      "resize": "velocitypnp.half-pixel-bilinear-u8.v1",
      "resize_coordinates": "half-pixel centers with clamped source edges",
      "resize_rounding": "round non-negative interpolated values down from x+0.5",
      "dimension_rounding": "round positive scaled dimensions down from x+0.5",
      "letterbox_rgb": [127, 127, 127]
    },
    "angle_period_degrees": 180,
    "polarity_supported": false
  }
}
